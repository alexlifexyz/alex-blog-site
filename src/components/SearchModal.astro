---
---

<!-- Search Trigger Modal -->
<div id="search-modal" class="search-modal print-hide" aria-hidden="true" role="dialog" aria-modal="true" style="display: none;">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-container">
    <div class="search-box">
      <svg class="search-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="search" 
        id="search-input" 
        class="search-input" 
        placeholder="搜索 100+ 篇技术文章、架构经验或思考... (按 ESC 关闭)" 
        autocomplete="off"
        spellcheck="false"
      />
      <span class="search-kbd mono">ESC</span>
    </div>

    <div class="search-results-wrap">
      <div id="search-status" class="search-status mono">输入关键词开始秒级全文检索</div>
      <ul id="search-results" class="search-results-list"></ul>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    let pagefind = null;
    const modal = document.getElementById("search-modal");
    const backdrop = document.getElementById("search-backdrop");
    const input = document.getElementById("search-input");
    const resultsList = document.getElementById("search-results");
    const status = document.getElementById("search-status");

    async function initPagefind() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import("/pagefind/pagefind.js");
        await pagefind.options({
          ranking: {
            termFrequency: 0.2,
            pageLength: 0.75,
          }
        });
        return pagefind;
      } catch (e) {
        console.warn("Pagefind not loaded (build needed):", e);
        return null;
      }
    }

    function openModal() {
      if (!modal) return;
      modal.style.display = "flex";
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      setTimeout(() => input && input.focus(), 50);
      initPagefind();
    }

    function closeModal() {
      if (!modal) return;
      modal.style.display = "none";
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (input) input.value = "";
      if (resultsList) resultsList.innerHTML = "";
      if (status) status.innerText = "输入关键词开始秒级全文检索";
    }

    // Global Hotkey: Cmd+K / Ctrl+K / '/'
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        modal.style.display === "none" ? openModal() : closeModal();
      } else if (e.key === "/" && !["INPUT", "TEXTAREA"].includes(document.activeElement.tagName)) {
        e.preventDefault();
        openModal();
      } else if (e.key === "Escape" && modal.style.display !== "none") {
        closeModal();
      }
    });

    if (backdrop) backdrop.addEventListener("click", closeModal);

    // Bind all elements with [data-open-search]
    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("[data-open-search]");
      if (trigger) {
        e.preventDefault();
        openModal();
      }
    });

    // Debounced search
    let debounceTimer = null;
    if (input) {
      input.addEventListener("input", (e) => {
        clearTimeout(debounceTimer);
        const query = e.target.value.trim();
        if (!query) {
          if (resultsList) resultsList.innerHTML = "";
          if (status) status.innerText = "输入关键词开始秒级全文检索";
          return;
        }

        debounceTimer = setTimeout(async () => {
          const pf = await initPagefind();
          if (!pf) {
            if (status) status.innerText = "本地开发预览中，执行 npm run build 后生效全文检索。";
            return;
          }

          if (status) status.innerText = "正在检索...";
          const search = await pf.search(query);
          
          if (!search.results.length) {
            if (status) status.innerText = `未找到关于 "${query}" 的文章`;
            if (resultsList) resultsList.innerHTML = "";
            return;
          }

          if (status) status.innerText = `找到 ${search.results.length} 篇相关内容：`;
          
          // Render top 8 results
          const topResults = search.results.slice(0, 8);
          const loadedData = await Promise.all(topResults.map((r) => r.data()));

          if (resultsList) {
            resultsList.innerHTML = loadedData.map((data) => {
              const cleanTitle = (data.meta && data.meta.title) ? data.meta.title.replace(/\s*\|\s*.*$/, "") : "无标题";
              return `
                <li class="search-result-item">
                  <a href="${data.url}" class="search-result-link">
                    <div class="result-title">${cleanTitle}</div>
                    <div class="result-excerpt">${data.excerpt}</div>
                  </a>
                </li>
              `;
            }).join("");
          }
        }, 120);
      });
    }
  })();
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 6rem 1.5rem 2rem;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .search-container {
    position: relative;
    width: 100%;
    max-width: 680px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    animation: searchDrop 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes searchDrop {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .search-icon {
    font-size: 1.25rem;
    opacity: 0.6;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.1rem;
    color: var(--text);
    font-family: inherit;
  }

  .search-input::placeholder {
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .search-kbd {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--surface-subtle);
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--text-dim);
  }

  .search-results-wrap {
    max-height: 480px;
    overflow-y: auto;
    padding: 1rem 1.5rem;
  }

  .search-status {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .search-results-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .search-result-item {
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }

  .search-result-link {
    display: block;
    padding: 0.85rem 1rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
    background: var(--surface-subtle);
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .search-result-link:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  }

  .result-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .search-result-link:hover .result-title {
    color: var(--accent);
  }

  .result-excerpt {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .result-excerpt mark {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.1rem 0.25rem;
    border-radius: 2px;
    font-weight: 600;
  }
</style>
