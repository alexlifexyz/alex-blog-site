---
// Full-text search over the Pagefind index built at `npm run build`.
---

<div class="search-dialog" id="search-dialog" role="dialog" aria-modal="true" aria-label="搜索文章" aria-hidden="true">
  <div class="search-panel">
    <label class="search-field">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <span class="visually-hidden">搜索文章</span>
      <input id="search-input" type="search" placeholder="搜索标题和正文" autocomplete="off" spellcheck="false" />
      <kbd>Esc</kbd>
    </label>
    <div class="search-body">
      <p class="search-status" id="search-status" aria-live="polite">输入关键词，例如 RAG、Claude、Java</p>
      <div class="search-results" id="search-results"></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var dialog = document.getElementById("search-dialog");
    var input = document.getElementById("search-input");
    var results = document.getElementById("search-results");
    var status = document.getElementById("search-status");
    var hint = status.textContent;
    var pagefind = null;
    var lastFocus = null;
    var active = -1;
    var timer = null;

    function load() {
      if (pagefind) return Promise.resolve(pagefind);
      return import("/pagefind/pagefind.js")
        .then(function (pf) {
          pagefind = pf;
          return pf;
        })
        .catch(function () {
          return null;
        });
    }

    function open() {
      lastFocus = document.activeElement;
      dialog.classList.add("open");
      dialog.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      input.focus();
      load();
    }

    function close() {
      dialog.classList.remove("open");
      dialog.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      input.value = "";
      results.innerHTML = "";
      status.textContent = hint;
      active = -1;
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function esc(s) {
      return String(s).replace(/[&<>"]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
      });
    }

    function setActive(i) {
      var links = results.querySelectorAll("a");
      if (!links.length) return;
      active = (i + links.length) % links.length;
      links.forEach(function (a, k) {
        a.classList.toggle("active", k === active);
      });
      links[active].scrollIntoView({ block: "nearest" });
    }

    async function run(q) {
      var pf = await load();
      if (!pf) {
        status.textContent = "搜索索引在构建后生成，本地开发时不可用。";
        return;
      }
      var res = await pf.search(q);
      if (input.value.trim() !== q) return;
      if (!res.results.length) {
        status.textContent = "没有找到包含“" + q + "”的文章";
        results.innerHTML = "";
        return;
      }
      var items = await Promise.all(res.results.slice(0, 10).map(function (r) { return r.data(); }));
      status.textContent = "共 " + res.results.length + " 篇";
      results.innerHTML = items
        .map(function (d) {
          var title = (d.meta && d.meta.title ? d.meta.title : d.url).replace(/\s*[|·–-]\s*Alex 的博客$/, "");
          return '<a href="' + esc(d.url) + '"><strong>' + esc(title) + "</strong><p>" + d.excerpt + "</p></a>";
        })
        .join("");
      active = -1;
    }

    input.addEventListener("input", function () {
      clearTimeout(timer);
      var q = input.value.trim();
      if (!q) {
        results.innerHTML = "";
        status.textContent = hint;
        return;
      }
      timer = setTimeout(function () { run(q); }, 150);
    });

    input.addEventListener("keydown", function (e) {
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Enter" && active >= 0) {
        e.preventDefault();
        results.querySelectorAll("a")[active].click();
      }
    });

    dialog.addEventListener("click", function (e) {
      if (e.target === dialog) close();
    });

    document.addEventListener("click", function (e) {
      if (e.target.closest("[data-open-search]")) {
        e.preventDefault();
        open();
      }
    });

    window.addEventListener("keydown", function (e) {
      var isOpen = dialog.classList.contains("open");
      var typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        isOpen ? close() : open();
      } else if (e.key === "/" && !typing && !isOpen) {
        e.preventDefault();
        open();
      } else if (e.key === "Escape" && isOpen) {
        close();
      }
    });
  })();
</script>
