---
// Sun / moon toggle. The icon shows the theme you will switch to.
// The choice is shared across *.alexai.top through a cookie, with localStorage as a fallback.
---

<button class="icon-btn theme-toggle" type="button" aria-label="切换浅色或深色" title="切换浅色 / 深色">
  <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
  </svg>
  <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var KEY = "alexai-theme";
    var COLORS = { light: "#F5F6F3", dark: "#15181B" };
    var root = document.documentElement;
    var btn = document.querySelector(".theme-toggle");
    if (!btn) return;

    function current() {
      return root.dataset.theme === "dark" ? "dark" : "light";
    }

    function label(theme) {
      btn.setAttribute("aria-label", theme === "dark" ? "切换到浅色" : "切换到深色");
    }

    function save(theme) {
      var domain = /(^|\.)alexai\.top$/.test(location.hostname) ? "; domain=.alexai.top" : "";
      document.cookie = KEY + "=" + theme + "; path=/; max-age=31536000; SameSite=Lax" + domain;
      try {
        localStorage.setItem(KEY, theme);
      } catch (e) {}
    }

    btn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      save(next);
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", COLORS[next]);
      label(next);
    });

    label(current());
  })();
</script>
