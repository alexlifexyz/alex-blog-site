---

<button
  class="theme-toggle"
  type="button"
  aria-label="切换浅色或深色"
  title="切换浅色 / 深色"
>
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.75" />
    <path
      d="M12 3v1.6M12 19.4V21M4.9 4.9l1.1 1.1M18 18l1.1 1.1M3 12h1.6M19.4 12H21M4.9 19.1l1.1-1.1M18 6l1.1-1.1"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
    />
  </svg>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M16.2 13.2A6.2 6.2 0 0 1 10.8 4.6 7 7 0 1 0 19.4 13.8a6.2 6.2 0 0 1-3.2-.6Z"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linejoin="round"
    />
  </svg>
</button>

<script is:inline>
  (function () {
    var KEY = "alexai-theme";
    var root = document.documentElement;
    var btn = document.querySelector(".theme-toggle");
    if (!btn) return;

    function paintMeta(theme) {
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", theme === "light" ? "#F4F6F8" : "#05070A");
    }

    function current() {
      return root.dataset.theme === "light" ? "light" : "dark";
    }

    function apply(theme) {
      root.dataset.theme = theme;
      root.dataset.themePref = theme;
      try {
        localStorage.setItem(KEY, theme);
      } catch (e) {}
      paintMeta(theme);
      btn.setAttribute("aria-label", theme === "light" ? "当前浅色，点击切换到深色" : "当前深色，点击切换到浅色");
    }

    btn.addEventListener("click", function () {
      apply(current() === "light" ? "dark" : "light");
    });

    btn.setAttribute("aria-label", current() === "light" ? "当前浅色，点击切换到深色" : "当前深色，点击切换到浅色");
  })();
</script>
