<script is:inline>
  (function () {
    var preBlocks = document.querySelectorAll(".prose pre");
    if (!preBlocks.length) return;

    preBlocks.forEach(function (pre) {
      // 避免重复包装
      if (pre.parentElement && pre.parentElement.classList.contains("code-block-wrap")) {
        return;
      }

      // 创建外层容器
      var wrap = document.createElement("div");
      wrap.className = "code-block-wrap";
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      // 获取代码语言
      var code = pre.querySelector("code");
      var lang = "CODE";
      if (code) {
        var classes = Array.from(code.classList);
        for (var i = 0; i < classes.length; i++) {
          var cls = classes[i];
          if (cls.startsWith("language-")) {
            lang = cls.replace("language-", "").toUpperCase();
            break;
          }
        }
      }

      // 工具栏
      var bar = document.createElement("div");
      bar.className = "code-block-bar";

      var langTag = document.createElement("span");
      langTag.className = "code-block-lang mono";
      langTag.textContent = lang;
      bar.appendChild(langTag);

      var copyBtn = document.createElement("button");
      copyBtn.className = "code-block-copy mono";
      copyBtn.type = "button";
      copyBtn.setAttribute("aria-label", "复制代码");
      copyBtn.innerHTML =
        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>COPY</span>';

      copyBtn.addEventListener("click", function () {
        var textToCopy = code ? code.innerText : pre.innerText;
        navigator.clipboard.writeText(textToCopy).then(function () {
          copyBtn.classList.add("copied");
          copyBtn.innerHTML =
            '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>COPIED</span>';
          setTimeout(function () {
            copyBtn.classList.remove("copied");
            copyBtn.innerHTML =
              '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>COPY</span>';
          }, 2000);
        });
      });

      bar.appendChild(copyBtn);
      wrap.insertBefore(bar, pre);
    });
  })();
</script>
