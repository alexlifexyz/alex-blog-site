---
interface Props {
  variant?: "sidebar" | "footer";
}

const { variant = "sidebar" } = Astro.props;
---

<div class={`wechat-card wechat-card-${variant}`}>
  <div class="wechat-badge">
    <svg class="wechat-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
    <span class="wechat-label mono">WeChat / 公众号</span>
  </div>
  <h3 class="wechat-title">关注 Alex 的日常更新</h3>
  <p class="wechat-desc">
    第一时间推送技术架构、企业级 RAG 落地白皮书、行业实战观察与程序员心路随笔。
  </p>
  <div class="wechat-action">
    <div class="wechat-id-box">
      <span class="wechat-id-label mono">公众号/微信号</span>
      <span class="wechat-id mono">alexlifexyz</span>
    </div>
    <a 
      href="https://mp.weixin.qq.com" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="wechat-btn"
    >
      前往阅读 ↗
    </a>
  </div>
</div>

<style>
  .wechat-card {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .wechat-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), #0f766e);
  }

  .wechat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.6rem;
    background: var(--accent-soft);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .wechat-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--text);
  }

  .wechat-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 1.25rem 0;
  }

  .wechat-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--surface-subtle);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
  }

  .wechat-id-box {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .wechat-id-label {
    font-size: 0.65rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .wechat-id {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }

  .wechat-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: opacity 0.2s ease;
  }

  .wechat-btn:hover {
    opacity: 0.9;
  }

  .wechat-card-footer {
    margin-top: 3.5rem;
    padding: 2rem;
  }
</style>
