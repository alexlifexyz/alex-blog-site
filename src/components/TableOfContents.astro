---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant: "aside" | "inline";
}

const { headings, variant } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minDepth = Math.min(...toc.map((h) => h.depth));
const items = toc.map((h) => ({ ...h, level: h.depth === minDepth ? 2 : 3, text: h.text.replace(/^■\s*/, "") }));
---

{
  items.length >= 3 &&
    (variant === "aside" ? (
      <aside class="toc" aria-label="目录">
        <p class="toc-title">目录</p>
        <nav>
          {items.map((h) => (
            <a href={`#${h.slug}`} class={`depth-${h.level}`} data-toc={h.slug}>
              {h.text}
            </a>
          ))}
        </nav>
      </aside>
    ) : (
      <details class="toc-inline">
        <summary>目录 · {items.length} 节</summary>
        <nav>
          {items.map((h) => (
            <a href={`#${h.slug}`} class={`depth-${h.level}`}>
              {h.text}
            </a>
          ))}
        </nav>
      </details>
    ))
}
