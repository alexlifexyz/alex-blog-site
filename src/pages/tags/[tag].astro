---
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostList from "../../components/PostList.astro";
import { getPublishedPosts, tagCounts } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BlogLayout title={`#${tag}`} description={`标签“${tag}”下的 ${posts.length} 篇文章。`} path={`/tags/${tag}`}>
  <div class="shell narrow page">
    <header>
      <a class="eyebrow back" href="/archive#tags">← 全部标签</a>
      <h1 class="page-title">#{tag}</h1>
      <p class="page-lead">{posts.length} 篇文章</p>
    </header>
    <div class="tag-posts">
      <PostList posts={posts} fullDate />
    </div>
  </div>
</BlogLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 0.75rem;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .tag-posts {
    margin-top: 2rem;
    border-top: 1px solid var(--rule-strong);
  }

  .tag-posts :global(.post-row) {
    grid-template-columns: 6.5rem minmax(0, 1fr);
  }

  @media (max-width: 560px) {
    .tag-posts :global(.post-row) {
      grid-template-columns: 1fr;
    }
  }
</style>
