---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import CopyCodeScript from "../../components/CopyCodeScript.astro";
import WeChatCard from "../../components/WeChatCard.astro";
import { getCategoryMeta } from "../../utils/categories";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index < posts.length - 1 ? posts[index + 1] : null,
      nextPost: index > 0 ? posts[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const catMeta = getCategoryMeta(post.data.category);

// 计算字数与阅读时长
const rawContent = post.body || "";
const cnWords = (rawContent.match(/[\u4e00-\u9fa5]/g) || []).length;
const enWords = (rawContent.match(/[a-zA-Z0-9_\-]+/g) || []).length;
const totalWords = cnWords + enWords;
const readTimeMinutes = Math.max(1, Math.ceil(totalWords / 350));
---

<BlogLayout title={`${post.data.title} | Alex.blog`} description={post.data.description} path="/">
  <!-- 顶部细线发光阅读进度条 -->
  <div class="reading-progress-bar print-hide" id="reading-progress" aria-hidden="true"></div>

  <div class="content-wrap page-block">
    <div class="article-layout">
      <article class="article-main" data-pagefind-body>
        <header class="article-header">
          <div class="article-meta mono">
            <span class="article-category" style={`color: ${catMeta.color};`}>{catMeta.name}</span>
            <span class="meta-sep">·</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, ".")}
            </time>
            <span class="meta-sep">·</span>
            <span>约 {readTimeMinutes} 分钟</span>
            <span class="meta-sep">·</span>
            <span>{totalWords.toLocaleString()} 字</span>
          </div>

          <h1 class="article-title">{post.data.title}</h1>
          <p class="article-desc">{post.data.description}</p>

          <div class="tag-row">
            {post.data.tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag" style="text-decoration: none;">#{tag}</a>
            ))}
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>

        <!-- 微信公众号引流名片 -->
        <div class="print-hide" data-pagefind-ignore>
          <WeChatCard variant="footer" />
        </div>

        <!-- 上一篇 / 下一篇导航 -->
        <nav class="post-nav print-hide" aria-label="文章翻页导航" data-pagefind-ignore>
          {prevPost ? (
            <a href={`/posts/${prevPost.slug}/`} class="post-nav-card prev">
              <span class="post-nav-label mono">← 上一篇</span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          ) : (
            <div class="post-nav-card empty"></div>
          )}
          {nextPost ? (
            <a href={`/posts/${nextPost.slug}/`} class="post-nav-card next">
              <span class="post-nav-label mono">下一篇 →</span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          ) : (
            <div class="post-nav-card empty"></div>
          )}
        </nav>

        <footer class="article-end" data-pagefind-ignore>
          <div>
            <h4>何占伟 / Alex</h4>
            <p>成都。11 年 Java 后端架构，专注企业级 RAG 与大模型应用工程化落地。</p>
          </div>
          <a href="/" class="btn btn-outline btn-compact">返回博客首页</a>
        </footer>
      </article>

      <!-- 右侧粘性目录大纲 -->
      <TableOfContents headings={headings} />
    </div>
  </div>

  <!-- 代码块一键复制脚本 -->
  <CopyCodeScript />

  <!-- 阅读进度监听脚本 -->
  <script is:inline>
    (function () {
      var bar = document.getElementById("reading-progress");
      if (!bar) return;

      function update() {
        var scrollTop = window.scrollY || document.documentElement.scrollTop;
        var scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        var progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        bar.style.width = Math.min(100, Math.max(0, progress)) + "%";
      }

      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update, { passive: true });
      update();
    })();
  </script>
</BlogLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 3.5rem;
    align-items: start;
    position: relative;
  }

  .article-main {
    min-width: 0;
  }

  .article-category {
    font-weight: 600;
  }

  .meta-sep {
    color: var(--text-dim);
    margin: 0 0.25rem;
  }

  /* 上一篇/下一篇翻页导航卡片 */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin: 3.5rem 0 2rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-nav-card:hover {
    border-color: var(--accent);
    background: var(--elevated);
    transform: translateY(-2px);
  }

  .post-nav-card.next {
    text-align: right;
  }

  .post-nav-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .post-nav-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-nav-card.empty {
    border: none;
    background: transparent;
  }

  @media (max-width: 960px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-card.next {
      text-align: left;
    }
  }
</style>
