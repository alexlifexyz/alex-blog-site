---
import BlogLayout from "../layouts/BlogLayout.astro";
import PostList from "../components/PostList.astro";
import { CATEGORIES, normalizeCategory, getCategoryMeta } from "../utils/categories";
import { getPublishedPosts, groupByYear, ymd, postUrl, plain } from "../utils/posts";

const posts = await getPublishedPosts();
const featured = posts.filter((p) => p.data.pinned || p.data.featured).slice(0, 3);
const groups = groupByYear(posts);

const counts: Record<string, number> = {};
for (const p of posts) {
  const c = normalizeCategory(p.data.category);
  counts[c] = (counts[c] || 0) + 1;
}
const filters = [
  { key: "all", name: "全部", count: posts.length },
  ...Object.values(CATEGORIES)
    .filter((c) => counts[c.slug])
    .map((c) => ({ key: c.slug, name: c.name, count: counts[c.slug] })),
];
---

<BlogLayout path="/">
  <div class="shell narrow page">
    <header class="home-intro">
      <h1 class="page-title">文章</h1>
      <p class="page-lead">
        写 Java 后端、Agent 与 RAG 的落地，也写一个做了 11 年后端的人怎么看这一轮 AI。
        <span class="home-links">
          <a class="link" href="/rss.xml">RSS 订阅</a>
          <span aria-hidden="true">·</span>
          公众号 alexlifexyz
        </span>
      </p>
    </header>

    {
      featured.length > 0 && (
        <section class="featured" aria-labelledby="featured-title">
          <h2 class="section-title" id="featured-title">精选</h2>
          <ol class="featured-list">
            {featured.map((post) => (
              <li>
                <a href={postUrl(post)}>
                  <span class="featured-meta">
                    <span class="cat">{getCategoryMeta(post.data.category).name}</span>
                    <time datetime={ymd(post.data.pubDate)}>{ymd(post.data.pubDate)}</time>
                  </span>
                  <h3>{post.data.title}</h3>
                  <p>{plain(post.data.description)}</p>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="all-posts" aria-labelledby="all-title">
      <div class="all-head">
        <h2 class="visually-hidden" id="all-title">全部文章</h2>
        <div class="filters" role="group" aria-label="按分类筛选">
          {
            filters.map((f) => (
              <button type="button" class="filter" data-filter={f.key} aria-pressed={f.key === "all" ? "true" : "false"}>
                {f.name}
                <span class="num">{f.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      {
        groups.map(([y, list]) => (
          <div class="year-group" data-year-group>
            <h3 class="year-head">
              {y}
              <small data-year-count>{list.length} 篇</small>
            </h3>
            <PostList posts={list} />
          </div>
        ))
      }
      <p class="empty-hint" id="empty-hint" hidden>这个分类下还没有文章。</p>
    </section>
  </div>
</BlogLayout>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll("[data-filter]");
    var groups = document.querySelectorAll("[data-year-group]");
    var empty = document.getElementById("empty-hint");

    function apply(key, push) {
      var any = false;
      buttons.forEach(function (b) {
        b.setAttribute("aria-pressed", b.dataset.filter === key ? "true" : "false");
      });
      groups.forEach(function (g) {
        var n = 0;
        g.querySelectorAll("li[data-category]").forEach(function (li) {
          var show = key === "all" || li.dataset.category === key;
          li.hidden = !show;
          if (show) n++;
        });
        g.hidden = n === 0;
        g.querySelector("[data-year-count]").textContent = n + " 篇";
        if (n) any = true;
      });
      empty.hidden = any;
      if (push) {
        var url = new URL(location.href);
        if (key === "all") url.searchParams.delete("cat");
        else url.searchParams.set("cat", key);
        history.replaceState(null, "", url);
      }
    }

    buttons.forEach(function (b) {
      b.addEventListener("click", function () {
        apply(b.dataset.filter, true);
      });
    });

    var initial = new URLSearchParams(location.search).get("cat");
    if (initial && document.querySelector('[data-filter="' + initial + '"]')) apply(initial, false);
  })();
</script>

<style>
  .home-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: 0.25rem;
    color: var(--faint);
    font-size: 0.95rem;
  }

  .featured {
    margin-top: clamp(2.25rem, 5vw, 3rem);
  }

  .featured-list > li + li {
    border-top: 1px solid var(--rule);
  }

  .featured-list a {
    display: block;
    padding: 1.25rem 0;
    text-decoration: none;
  }

  .featured-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .featured-list h3 {
    margin-top: 0.35rem;
    font-size: 1.3rem;
    line-height: 1.45;
    transition: color 0.15s ease;
  }

  .featured-list a:hover h3 {
    color: var(--accent);
  }

  .featured-list p {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .all-posts {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .all-head {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
    padding: 0.75rem 0;
    margin-bottom: 1rem;
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 34px;
    padding: 0 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 0.9rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .filter .num {
    font-size: 0.8rem;
    color: var(--faint);
  }

  .filter:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .filter[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .filter[aria-pressed="true"] .num {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }

  .empty-hint {
    color: var(--faint);
    padding: 2rem 0;
  }
</style>
