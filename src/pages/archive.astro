---
import BlogLayout from "../layouts/BlogLayout.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts, groupByYear, tagCounts } from "../utils/posts";

const posts = await getPublishedPosts();
const groups = groupByYear(posts);
const tags = tagCounts(posts);
---

<BlogLayout title="归档" description="按时间和标签浏览全部文章。" path="/archive">
  <div class="shell narrow page">
    <header>
      <h1 class="page-title">归档</h1>
      <p class="page-lead">共 {posts.length} 篇，按时间倒序。也可以按标签找。</p>
    </header>

    <section class="tags-section" id="tags" aria-labelledby="tags-title">
      <h2 class="section-title" id="tags-title">标签</h2>
      <div class="tag-cloud">
        {
          tags.map(([t, n]) => (
            <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
              {t}
              <span class="tag-count">{n}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="archive-years" aria-label="按年份">
      {
        groups.map(([y, list]) => (
          <div class="year-group">
            <h2 class="year-head">
              {y}
              <small>{list.length} 篇</small>
            </h2>
            <PostList posts={list} compact />
          </div>
        ))
      }
    </section>
  </div>
</BlogLayout>

<style>
  .tags-section {
    margin-top: 2.5rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .archive-years {
    margin-top: 3rem;
  }
</style>
