---
import "../styles/fonts-subset.css";
import "../styles/fonts.css";
import "../styles/global.css";
import BrandMark from "../components/BrandMark.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const SITE_NAME = "何占伟的博客";
const {
  title,
  description = "何占伟（Alex）的博客：Java 后端、Agent 与 RAG 落地，以及一个老程序员对这一轮 AI 的观察。",
  path = "/",
  type = "website",
  publishedTime,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const site = Astro.site || new URL("https://blog.alexai.top");
const canonicalURL = new URL(Astro.url.pathname, site);
const socialImageURL = new URL("/social-card.png?v=5", site);
const squareThumbURL = new URL("/wechat-thumb.png?v=5", site);

const navItems = [
  { label: "文章", href: "/" },
  { label: "归档", href: "/archive" },
  { label: "主站", href: "https://alexai.top", external: true, optional: true },
];
const isCurrent = (href: string) =>
  href === "/" ? path === "/" || path.startsWith("/posts") : path === href || path.startsWith(href + "/") || (href === "/archive" && path.startsWith("/tags"));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="何占伟 / Alex" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#F5F6F3" />
    <script is:inline>
      (function () {
        var theme = null;
        var m = document.cookie.match(/(?:^|;\s*)alexai-theme=(light|dark)/);
        if (m) theme = m[1];
        if (!theme) {
          try {
            var saved = localStorage.getItem("alexai-theme");
            if (saved === "light" || saved === "dark") theme = saved;
          } catch (e) {}
        }
        if (!theme) theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#15181B" : "#F5F6F3");
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=5" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=5" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="preload" href="/fonts/ibm-plex-sans/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta itemprop="name" content={fullTitle} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={squareThumbURL} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title || SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={squareThumbURL} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
  </head>
  <body>
    <!-- WeChat's mobile crawler takes the first image in <body> as the share thumbnail. Kept off-screen, not display:none. -->
    <div style="position:absolute;top:-9999px;left:-9999px;width:0;height:0;overflow:hidden;" aria-hidden="true">
      <img src={squareThumbURL.href} alt="" width="400" height="400" />
    </div>

    <header class="site-header">
      <div class="shell site-header-inner">
        <a class="brand" href="/" aria-label="何占伟的博客，返回首页">
          <BrandMark />
          <span class="brand-name">何占伟</span>
          <span class="brand-section">博客</span>
        </a>
        <div class="header-right">
          <nav class="site-nav" aria-label="主导航">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class:list={{ "nav-optional": item.optional }}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener" : undefined}
                  aria-current={!item.external && isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <button class="icon-btn" type="button" data-open-search aria-label="搜索文章" title="搜索（/ 或 ⌘K）">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </button>
          <ThemeSwitch />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-inner">
          <div class="footer-who">
            <strong>何占伟</strong>
            Java 后端，成都
          </div>
          <div class="footer-links">
            <a href="https://alexai.top" target="_blank" rel="noopener">主站</a>
            <a href="https://rag.alexai.top" target="_blank" rel="noopener">RAG Lab</a>
            <a href="https://github.com/alexlifexyz" target="_blank" rel="noopener">GitHub</a>
            <a href="/rss.xml">RSS</a>
          </div>
        </div>
        <p class="footer-meta">&copy; {new Date().getFullYear()} 何占伟 · 公众号 alexlifexyz</p>
      </div>
    </footer>

    <SearchModal />
  </body>
</html>
